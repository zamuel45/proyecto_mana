# Configuración del servidor de tiempo real de Maná
# Puerto donde escucha Socket.io (los celulares se conectan a http://IP-DEL-PC:3001)
PUERTO=3001
# Dirección de la API PHP en XAMPP (si tu carpeta en htdocs no se llama "mana", cámbiala aquí)
API_URL=http://127.0.0.1/mana_proyecto_completo/mana/api
# Debe ser IGUAL a CLAVE_INTERNA en api/config.php
CLAVE_INTERNA=mana-clave-interna-cambiar
