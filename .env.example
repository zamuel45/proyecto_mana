# =====================================================================
#  Maná — variables de entorno de docker-compose.yml
#  Copia este archivo como ".env" y cambia TODOS los valores secretos.
#  Genera secretos con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#  El archivo .env NUNCA se sube a git.
# =====================================================================

# Dirección pública de la aplicación (en el VPS: https://tu-dominio.com)
URL_PUBLICA=http://localhost:8080
# Puerto de Nginx. En el VPS usa 127.0.0.1:8080 (solo accesible por el Nginx con HTTPS, ver deploy/nginx-vps.conf)
PUERTO_WEB=8080
PUERTO_POSTGRES=5432

# Secreto con el que GoTrue firma los JWT y PostgREST/Node los verifican (mínimo 32 caracteres)
JWT_SECRET=cambia-esto-por-un-secreto-largo-de-al-menos-32-caracteres
# Duración de la sesión en segundos (43200 = 12 horas)
JWT_DURACION_SEGUNDOS=43200

# Contraseñas de los roles de PostgreSQL
POSTGRES_PASSWORD=cambia-esto
AUTHENTICATOR_PASSWORD=cambia-esto
AUTH_DB_PASSWORD=cambia-esto
SERVICIO_DB_PASSWORD=cambia-esto

# Primer súper-administrador (equipo Maná). Se crea solo si todavía no existe ninguno.
SUPERADMIN_EMAIL=super@mana.co
SUPERADMIN_PASSWORD=

# 1 = con la base vacía, carga el Restaurante Jaider de ejemplo (usuarios de prueba). En el VPS: 0
SEMILLA_DEMO=0

# Correo transaccional (Resend). Vacío = los correos se escriben en realtime/logs/correos.log
RESEND_API_KEY=
CORREO_REMITENTE=Maná <onboarding@resend.dev>
